# terraform.tfvars にコピーして使う（terraform.tfvars は gitignore 対象）。値は見本。
# アカウントIDは書かない。デプロイ先から自動で引く。

project_name = "shirabe"
environment  = "prd"
region       = "ap-northeast-1"

# GitHub Actions に AWS への入口を許すリポジトリ（owner/repo）。大文字小文字は GitHub 上の表記に合わせる
github_repository = "example-owner/example-repo"

# OIDC プロバイダが既にあるアカウントでは false にする
create_github_oidc_provider = true
