{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "language": "japanese",
  "permissions": {
    "allow": [
      "Bash(ls *)",
      "Bash(rg *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git worktree *)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git stash*)",
      "Bash(gh label *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list*)",
      "Bash(gh issue view *)",
      "Bash(gh issue list*)",
      "Bash(gh repo view *)",
      "Bash(pnpm test*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm exec vitest run*)",
      "Read(./**)",
      "Edit(./**)",
      "Bash(gh issue create*)",
      "Bash(gh issue edit*)",
      "Bash(gh issue close*)",
      "Bash(gh issue reopen*)",
      "Bash(gh issue comment*)",
      "Bash(gh pr create*)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(python -m unittest *)",
      "Bash(python3 -m unittest *)",
      "Bash(terraform fmt*)",
      "Bash(terraform init*)",
      "Bash(terraform validate*)",
      "Bash(terraform test*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr edit*)",
      "Bash(gh pr comment*)",
      "Bash(gh run view*)",
      "Bash(gh run list*)",
      "Bash(terraform -chdir=infra/bootstrap fmt*)",
      "Bash(terraform -chdir=infra/bootstrap init*)",
      "Bash(terraform -chdir=infra/bootstrap validate*)",
      "Bash(terraform -chdir=infra/bootstrap test*)"
    ],
    "ask": [
      "Bash(terraform destroy*)",
      "Bash(terraform apply*)",
      "Bash(git reset --hard*)",
      "Bash(gh issue delete*)",
      "Bash(gh pr merge*)",
      "Bash(pip install*)",
      "Read(../**)",
      "Bash(gh repo delete*)",
      "Bash(gh repo edit*)",
      "Bash(gh repo create*)",
      "Bash(terraform -chdir=* apply*)",
      "Bash(terraform -chdir=* destroy*)",
      "Bash(node *)",
      "Bash(npx *)",
      "Bash(npm install*)",
      "Bash(pnpm dlx*)",
      "Bash(pnpm add*)",
      "Bash(pnpm * dlx*)",
      "Bash(pnpm * add*)",
      "Bash(pnpx *)",
      "Bash(git restore*)",
      "Bash(git rebase*-x*)",
      "Bash(git rebase*--exec*)",
      "Bash(git *--upload-pack*)",
      "Bash(git *--receive-pack*)",
      "Bash(git checkout*--*)",
      "Bash(git checkout* -f*)",
      "Bash(git checkout* -B*)",
      "Bash(git switch*--discard*)",
      "Bash(git switch* -C*)",
      "Bash(git push*)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(git checkout .*)",
      "Bash(git switch* -f*)",
      "Bash(git switch*--force*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(git add -f*)",
      "Bash(git add --force*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit -n*)",
      "Edit(./.git/**)",
      "Bash(git -c *)",
      "Read(./private/**)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(cat ./.env)",
      "Bash(cat ./.env.*)",
      "Read(**/.env*)",
      "Read(**/secrets/**)",
      "Read(~/Downloads/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.git-credentials)",
      "Read(~/.docker/config.json)",
      "Read(~/.kube/**)",
      "Read(~/.npmrc)",
      "Read(~/.terraform.d/credentials.tfrc.json)",
      "Read(~/AppData/Local/Google/Chrome/**)",
      "Read(~/AppData/Local/Microsoft/Edge/**)",
      "Read(~/AppData/Roaming/Mozilla/**)",
      "Edit(../**)",
      "Bash(git push*--force*)",
      "Bash(git push* -f*)"
    ]
  },
  "autoMemoryEnabled": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-hook-bypass.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-unchecked-gh-writes.sh\"",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Read|Edit|Write|NotebookEdit|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-sensitive-paths.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/cleanup-merged-worktrees.sh\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
